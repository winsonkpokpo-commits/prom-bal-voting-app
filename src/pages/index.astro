---
import Layout from '../components/Layout.astro';
import GlassCard from '../components/GlassCard.astro';
import GoldButton from '../components/GoldButton.astro';

// Liste temporaire pour l'affichage (à lier à ton backend plus tard)
const categories = ["Roi du bal", "Reine du bal", "Le mieux habillé"]; 
---

<Layout title="Vote - Bal de Promo">
  <div class="header">
    <h1>Bal de Promo 2024</h1>
    <p>La Nuit des Étoiles - Votez pour vos favoris</p>
  </div>

  {categories.map((category) => (
    <GlassCard title={category}>
      <form action="/api/vote" method="POST">
        <input type="hidden" name="category" value={category} />
        <label style="display:block; margin-bottom: 8px; color: #aaa;">Sélectionnez un candidat :</label>
        <input type="text" name="voted_for" placeholder="Nom complet du candidat..." required />
        <GoldButton text="Voter" type="submit" />
      </form>
    </GlassCard>
  ))}

  <div class="admin-link-container">
    <a href="/admin" class="admin-link">
      <span class="icon">🔒</span> Accès Administrateur
    </a>
  </div>
</Layout>

<style>
  .header {
    text-align: center;
    margin-bottom: 3rem;
  }
  
  .header p {
    color: #a0a0a0;
    font-style: italic;
    font-size: 1.2rem;
  }

  .admin-link-container {
    text-align: center;
    margin-top: 4rem;
  }

  .admin-link {
    color: rgba(212, 175, 55, 0.5);
    text-decoration: none;
    font-size: 0.9rem;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
<a href="/login" style="display: block; text-align: center; opacity: 0.2; font-size: 12px; text-decoration: none; color: white; margin-top: 40px;">
  π
</a>

  .admin-link:hover {
    color: var(--gold);
  }
</style>
