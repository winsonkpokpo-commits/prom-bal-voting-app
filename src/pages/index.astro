---
import Layout from '../components/Layout.astro';
import GlassCard from '../components/GlassCard.astro';
import GoldButton from '../components/GoldButton.astro';

// Liste des catégories du bal
const categories = ["Roi du Bal", "Reine du Bal", "Le/La plus élégant(e)", "Le duo de la soirée"];
---

<Layout title="Bal Masqué 2026 - CPEG Ste Bakhita">
  
  <div id="success-notification" class="notification hidden">
    ✅ Votre vote a bien été enregistré !
  </div>

  <div class="hero-section">
    <svg viewBox="0 0 100 60" class="custom-mask-icon" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#FFE066" />
          <stop offset="50%" stop-color="#D4AF37" />
          <stop offset="100%" stop-color="#997A15" />
        </linearGradient>
        <filter id="maskGlow" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="0" dy="4" stdDeviation="4" flood-color="#D4AF37" flood-opacity="0.4"/>
        </filter>
      </defs>
      <path d="M 10 25 C 10 5, 35 10, 50 20 C 65 10, 90 5, 90 25 C 95 45, 75 50, 50 35 C 25 50, 5 45, 10 25 Z" fill="url(#goldGrad)" filter="url(#maskGlow)"/>
      <path d="M 22 28 Q 30 22 38 28 Q 30 33 22 28 Z" fill="#121212" />
      <path d="M 62 28 Q 70 22 78 28 Q 70 33 62 28 Z" fill="#121212" />
      <path d="M 25 15 C 30 10, 40 15, 45 18" stroke="#FFFFFF" stroke-width="1.5" fill="none" opacity="0.6" stroke-linecap="round"/>
      <path d="M 75 15 C 70 10, 60 15, 55 18" stroke="#FFFFFF" stroke-width="1.5" fill="none" opacity="0.6" stroke-linecap="round"/>
      <polygon points="50,8 53,13 50,18 47,13" fill="#FFFFFF" opacity="0.9"/>
    </svg>

    <span class="school-badge">CPEG Ste Bakhita</span>
    <h1>Le Bal Masqué 2026</h1>
    <p class="subtitle">L'anonymat tombe le temps d'une nuit... Élisez les rois et reines de la soirée.</p>
  </div>

  <div class="voting-container">
    {categories.map((category) => (
      <GlassCard title={category}>
        <form action="/api/vote" method="POST">
          <input type="hidden" name="category" value={category} />
          <label class="input-label">Votre favori(te) :</label>
          <input type="text" name="voted_for" placeholder="Entrez un nom complet..." required />
          <GoldButton text="Valider mon vote" type="submit" />
        </form>
      </GlassCard>
    ))}
  </div>

  <div class="footer-admin">
    <a href="/admin" class="admin-link">🔒 Administration</a>
  </div>

</Layout>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('success')) {
      const notif = document.getElementById('success-notification');
      notif.classList.remove('hidden');
      notif.classList.add('show');
      
      // Cache la notification après 4 secondes
      setTimeout(() => {
        notif.classList.remove('show');
        notif.classList.add('hidden');
        // Nettoie l'URL sans recharger la page
        window.history.replaceState({}, document.title, window.location.pathname);
      }, 4000);
    }
  });
</script>

<style>
  /* --- STYLES GÉNÉRAUX ACCUEIL --- */
  .hero-section {
    text-align: center;
    padding: 2.5rem 1rem 1.5rem 1rem;
    position: relative;
  }

  /* --- STYLES DU MASQUE VÉNITIEN --- */
  .custom-mask-icon {
    width: 90px;
    height: auto;
    margin: 0 auto 1.5rem auto;
    display: block;
    animation: float-mask 4s ease-in-out infinite;
  }

  @keyframes float-mask {
    0% { transform: translateY(0px) scale(1); }
    50% { transform: translateY(-8px) scale(1.02); }
    100% { transform: translateY(0px) scale(1); }
  }

  /* --- BADGE ET TITRE --- */
  .school-badge {
    display: inline-block;
    background: rgba(245, 208, 97, 0.1);
    color: var(--gold, #D4AF37);
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    border: 1px solid rgba(245, 208, 97, 0.3);
    margin-bottom: 1rem;
  }

  .hero-section h1 {
    font-size: 2.2rem;
    background: linear-gradient(135deg, #fff 30%, var(--gold, #D4AF37) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: #a1a1aa;
    font-size: 0.95rem;
    max-width: 400px;
    margin: 0 auto 2rem auto;
    line-height: 1.5;
  }

  /* --- FORMULAIRE DE VOTE --- */
  .voting-container {
    max-width: 800px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    padding: 0 1rem;
  }
  @media (min-width: 768px) {
    .voting-container { grid-template-columns: 1fr 1fr; }
  }

  .input-label {
    display: block;
    margin-bottom: 8px;
    color: #d4d4d8;
    font-size: 0.9rem;
    font-weight: 500;
  }

  input[type="text"] {
    width: 100%;
    padding: 12px;
    margin-bottom: 1rem;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: #fff;
    box-sizing: border-box;
  }
  input[type="text"]:focus {
    outline: none;
    border-color: var(--gold, #D4AF37);
  }

  /* --- NOTIFICATION DE SUCCÈS --- */
  .notification {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: #4ade80;
    color: #064e3b;
    padding: 12px 24px;
    border-radius: 30px;
    font-weight: bold;
    box-shadow: 0 4px 15px rgba(74, 222, 128, 0.4);
    z-index: 1000;
    transition: opacity 0.5s ease, top 0.5s ease;
  }
  .hidden {
    opacity: 0;
    pointer-events: none;
    top: -50px;
  }
  .show {
    opacity: 1;
    top: 20px;
  }

  /* --- PIED DE PAGE --- */
  .footer-admin {
    text-align: center;
    margin-top: 4rem;
    padding-bottom: 2rem;
  }

  .admin-link {
    color: rgba(255, 255, 255, 0.3);
    text-decoration: none;
    font-size: 0.85rem;
    transition: color 0.3s ease;
  }

  .admin-link:hover {
    color: var(--gold, #D4AF37);
  }
</style>
