---
import Layout from '../components/Layout.astro';
import GlassCard from '../components/GlassCard.astro';
import GoldButton from '../components/GoldButton.astro';
import { supabase } from '../lib/supabase';

const { data: categoriesData } = await supabase
  .from('categories')
  .select('id, name, slots')
  .order('position', { ascending: true });

const { data: participantsData } = await supabase
  .from('participants')
  .select('id, name, photo_url')
  .order('name', { ascending: true });

const { data: configData } = await supabase
  .from('config')
  .select('voting_closed')
  .eq('id', 1)
  .single();

const categories = categoriesData || [];
const participants = participantsData || [];
const votingClosed = configData?.voting_closed || false;
---

<Layout title="Bal Masqué 2026 - CPEG Ste Bakhita">

  <div id="success-notification" class="notification hidden">
    ✅ Votre vote a bien été enregistré !
  </div>

  <div class="hero-section">
    <svg viewBox="0 0 200 110" class="custom-mask-icon" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="goldFiligree" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#FFF3B0" />
          <stop offset="30%" stop-color="#D4AF37" />
          <stop offset="70%" stop-color="#AA7C11" />
          <stop offset="100%" stop-color="#FFD700" />
        </linearGradient>
        <radialGradient id="maskGlow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#D4AF37" stop-opacity="0.35"/>
          <stop offset="100%" stop-color="#D4AF37" stop-opacity="0"/>
        </radialGradient>
        <filter id="shadow3D" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="0" dy="5" stdDeviation="5" flood-color="#D4AF37" flood-opacity="0.5"/>
        </filter>
      </defs>
      <ellipse cx="100" cy="55" rx="85" ry="45" fill="url(#maskGlow)" />
      <path d="M 100,75 C 85,92 55,95 25,82 C 8,74 -2,55 3,38 C 8,18 32,18 65,30 C 82,36 94,44 100,48 C 106,44 118,36 135,30 C 168,18 192,18 197,38 C 202,55 192,74 175,82 C 145,95 115,92 100,75 Z"
            fill="#09090C" stroke="url(#goldFiligree)" stroke-width="2.2" filter="url(#shadow3D)" />
      <path d="M 32,54 Q 55,40 78,54 Q 55,68 32,54 Z" fill="#000" stroke="url(#goldFiligree)" stroke-width="1.5" />
      <path d="M 122,54 Q 145,40 168,54 Q 145,68 122,54 Z" fill="#000" stroke="url(#goldFiligree)" stroke-width="1.5" />
      <path d="M 100,12 L 106,28 L 100,24 L 94,28 Z" fill="url(#goldFiligree)" />
      <path d="M 100,5 L 109,24 L 100,20 L 91,24 Z" fill="url(#goldFiligree)" opacity="0.8" />
      <circle cx="100" cy="4" r="2.5" fill="#FFFFFF" />
      <path d="M 100,28 C 82,12 55,10 30,20 C 15,25 8,30 5,18 C 22,8 55,8 85,22 Z" fill="url(#goldFiligree)" opacity="0.85" />
      <path d="M 28,26 C 45,18 68,22 80,32" stroke="url(#goldFiligree)" stroke-width="1.2" fill="none" />
      <path d="M 18,44 C 10,36 12,26 22,28 M 12,58 C 4,50 6,38 18,42" stroke="url(#goldFiligree)" stroke-width="1.2" fill="none" />
      <path d="M 100,28 C 118,12 145,10 170,20 C 185,25 192,30 195,18 C 178,8 145,8 115,22 Z" fill="url(#goldFiligree)" opacity="0.85" />
      <path d="M 172,26 C 155,18 132,22 120,32" stroke="url(#goldFiligree)" stroke-width="1.2" fill="none" />
      <path d="M 182,44 C 190,36 188,26 178,28 M 188,58 C 196,50 194,38 182,42" stroke="url(#goldFiligree)" stroke-width="1.2" fill="none" />
      <path d="M 48,76 C 32,80 18,72 24,62 C 28,55 40,60 46,68" stroke="url(#goldFiligree)" stroke-width="1.2" fill="none" />
      <path d="M 152,76 C 168,80 182,72 176,62 C 172,55 160,60 154,68" stroke="url(#goldFiligree)" stroke-width="1.2" fill="none" />
      <path d="M 100,48 L 96,65 L 100,70 L 104,65 Z" fill="url(#goldFiligree)" />
    </svg>

    <span class="school-badge">CPEG Ste Bakhita</span>
    <h1>Le Bal Masqué 2026</h1>
    <p class="subtitle">L'anonymat tombe le temps d'une nuit... Élisez les rois et reines de la soirée.</p>
  </div>

  {votingClosed && (
    <div class="voting-closed-banner">
      🔒 Les votes sont actuellement clos. Merci de votre participation !
      <p><a href="/results">Voir les résultats officiels →</a></p>
    </div>
  )}

  {!votingClosed && participants.length === 0 && (
    <p class="empty-categories">Aucun participant n'a encore été ajouté. Revenez plus tard !</p>
  )}

  {!votingClosed && categories.length === 0 && (
    <p class="empty-categories">Aucune catégorie de vote disponible pour le moment.</p>
  )}

  {!votingClosed && categories.length > 0 && participants.length > 0 && (
    <form id="ballot-form" class="ballot-form">
      <div class="voter-name-section">
        <GlassCard>
          <label class="input-label" for="voter-name-master">Votre nom complet :</label>
          <input type="text" id="voter-name-master" placeholder="Ex: Marie Dupont" autocomplete="name" />
          <p class="hint-small">Ce nom doit correspondre exactement à la liste des élèves autorisés à voter.</p>
        </GlassCard>
      </div>

      <div class="voting-container">
        {categories.map((category) => (
          <GlassCard title={category.slots > 1 ? `${category.name} (choisissez ${category.slots})` : category.name}>
            <input
              type="text"
              class="participant-search"
              placeholder="🔍 Rechercher un participant..."
              data-target={`participants-${category.id}`}
            />

            <div
              class="participants-grid"
              id={`participants-${category.id}`}
              data-slots={category.slots}
              data-category-id={category.id}
            >
              {participants.map((p) => (
                <label class="participant-option" data-name={p.name.toLowerCase()}>
                  <input
                    type={category.slots > 1 ? 'checkbox' : 'radio'}
                    name={`cat_${category.id}`}
                    value={p.id}
                  />
                  <img
                    src={p.photo_url || `https://ui-avatars.com/api/?name=${encodeURIComponent(p.name)}&background=D4AF37&color=fff`}
                    alt=""
                    class="participant-photo"
                  />
                  <span class="participant-label-name">{p.name}</span>
                </label>
              ))}
              <label class="participant-option blank-option" data-name="vote blanc">
                <input
                  type={category.slots > 1 ? 'checkbox' : 'radio'}
                  name={`cat_${category.id}`}
                  value="__blank__"
                  class="blank-input"
                />
                <span class="blank-icon">🗳️</span>
                <span class="participant-label-name">Vote Blanc</span>
              </label>
            </div>
          </GlassCard>
        ))}
      </div>

      <div class="submit-section">
        <GoldButton text="Valider mon vote" type="submit" />
      </div>
    </form>
  )}

  <div class="footer-admin">
    <a href="/admin" class="admin-link">🔒 Administration</a>
    <p class="credit-line">Réalisé par Winson KPOKPO en collaboration avec Trésor GNANSOUNOU</p>
  </div>

</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const COOKIE_NAME = 'voter_name';
    const masterInput = document.getElementById('voter-name-master');
    const form = document.getElementById('ballot-form');
    const notif = document.getElementById('success-notification');

    const getCookie = (key) => {
      const match = document.cookie.match(new RegExp('(?:^|; )' + key + '=([^;]*)'));
      return match ? decodeURIComponent(match[1]) : '';
    };
    const setCookie = (key, value) => {
      document.cookie = `${key}=${encodeURIComponent(value)}; path=/; max-age=86400; SameSite=Lax`;
    };

    if (masterInput) {
      const savedName = getCookie(COOKIE_NAME);
      if (savedName) masterInput.value = savedName;
    }

    // Recherche par catégorie
    document.querySelectorAll('.participant-search').forEach((input) => {
      input.addEventListener('input', () => {
        const container = document.getElementById(input.dataset.target);
        if (!container) return;
        const query = input.value.trim().toLowerCase();
        container.querySelectorAll('.participant-option').forEach((opt) => {
          if (opt.classList.contains('blank-option')) return;
          const name = opt.dataset.name || '';
          opt.style.display = name.includes(query) ? '' : 'none';
        });
      });
    });

    // Gestion des sélections (limite au nombre de slots, exclusivité du vote blanc)
    document.querySelectorAll('.participants-grid').forEach((grid) => {
      const slots = parseInt(grid.dataset.slots, 10) || 1;

      grid.addEventListener('change', (e) => {
        if (!e.target.matches('input')) return;

        const blankInput = grid.querySelector('.blank-input');
        const candidateInputs = Array.from(grid.querySelectorAll('input:not(.blank-input)'));

        if (e.target === blankInput) {
          if (blankInput.checked) {
            candidateInputs.forEach((inp) => { inp.checked = false; if (slots > 1) inp.disabled = true; });
          } else {
            candidateInputs.forEach((inp) => { inp.disabled = false; });
          }
        } else if (slots > 1) {
          const checkedCount = candidateInputs.filter((inp) => inp.checked).length;
          candidateInputs.forEach((inp) => { inp.disabled = !inp.checked && checkedCount >= slots; });
          if (blankInput) blankInput.disabled = checkedCount > 0;
        }

        grid.querySelectorAll('.participant-option').forEach((opt) => {
          const inp = opt.querySelector('input');
          opt.classList.toggle('selected', inp.checked);
        });
      });
    });

    function collectSelections() {
      const selections = [];
      let incompleteGrid = null;

      document.querySelectorAll('.participants-grid').forEach((grid) => {
        const slots = parseInt(grid.dataset.slots, 10) || 1;
        const categoryId = grid.dataset.categoryId;
        const blankInput = grid.querySelector('.blank-input');

        if (blankInput?.checked) {
          selections.push({ category_id: categoryId, participant_ids: [] });
          return;
        }

        const checked = Array.from(grid.querySelectorAll('input:checked:not(.blank-input)'));
        if (checked.length !== slots) {
          if (!incompleteGrid) incompleteGrid = grid;
          return;
        }
        selections.push({ category_id: categoryId, participant_ids: checked.map((inp) => inp.value) });
      });

      return { selections, incompleteGrid };
    }

    const errorMessages = {
      CHAMPS_MANQUANTS: "Merci de remplir votre nom avant de valider.",
      NOM_INVALIDE: "Le nom saisi n'est pas valide.",
      DONNEES_INVALIDES: "Une erreur est survenue, merci de réessayer.",
      VOTES_FERMES: "Les votes sont actuellement fermés.",
      VOTANT_NON_AUTORISE: "Ce nom ne figure pas sur la liste des électeurs autorisés. Vérifiez l'orthographe ou contactez l'administration.",
      DEJA_VOTE: "Vous avez déjà voté (au moins une des catégories a déjà été enregistrée).",
      NOMBRE_PARTICIPANTS_INVALIDE: "Le nombre de participants sélectionnés ne correspond pas à ce qui est attendu.",
      ERREUR_SERVEUR: "Erreur serveur, merci de réessayer dans quelques instants."
    };

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = masterInput ? masterInput.value.trim() : '';
      if (!name) {
        alert("Merci d'indiquer votre nom complet avant de voter.");
        masterInput?.focus();
        return;
      }

      const { selections, incompleteGrid } = collectSelections();
      if (incompleteGrid) {
        alert("Merci de compléter votre sélection pour toutes les catégories (ou choisissez Vote Blanc).");
        incompleteGrid.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      const submitBtn = form.querySelector('button[type="submit"]');
      if (submitBtn) submitBtn.disabled = true;

      try {
        const res = await fetch('/api/vote', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ voter_name: name, selections })
        });
        const data = await res.json();

        if (res.ok && data.success) {
          setCookie(COOKIE_NAME, name);
          notif.classList.remove('hidden');
          notif.classList.add('show');
          form.querySelectorAll('input, button').forEach((el) => { el.disabled = true; });
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          alert(errorMessages[data.error] || "Une erreur est survenue.");
          if (submitBtn) submitBtn.disabled = false;
        }
      } catch (err) {
        alert("Erreur réseau, vérifiez votre connexion.");
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  });
</script>

<style>
  .hero-section { text-align: center; padding: 2rem 1rem 1.5rem 1rem; position: relative; }
  .custom-mask-icon { width: 150px; height: auto; margin: 0 auto 1rem auto; display: block; animation: float-mask 4s ease-in-out infinite; }
  @keyframes float-mask {
    0% { transform: translateY(0px) scale(1); }
    50% { transform: translateY(-7px) scale(1.02); }
    100% { transform: translateY(0px) scale(1); }
  }
  .school-badge {
    display: inline-block; background: rgba(245, 208, 97, 0.1); color: var(--gold, #D4AF37);
    padding: 6px 16px; border-radius: 20px; font-size: 0.85rem; font-weight: 600;
    letter-spacing: 2px; text-transform: uppercase; border: 1px solid rgba(245, 208, 97, 0.3); margin-bottom: 1rem;
  }
  .hero-section h1 {
    font-size: 2.2rem; background: linear-gradient(135deg, #fff 30%, var(--gold, #D4AF37) 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 0.5rem;
  }
  .subtitle { color: #a1a1aa; font-size: 0.95rem; max-width: 400px; margin: 0 auto 2rem auto; line-height: 1.5; }

  .voting-closed-banner {
    max-width: 600px; margin: 2rem auto; padding: 1.5rem; text-align: center;
    background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.4);
    border-radius: 12px; color: #fca5a5;
  }
  .voting-closed-banner a { color: var(--gold, #D4AF37); }

  .voter-name-section { max-width: 600px; margin: 0 auto 1.5rem auto; padding: 0 1rem; }
  .hint-small { font-size: 0.8rem; color: #a1a1aa; margin-top: -0.5rem; }

  .voting-container { max-width: 800px; margin: 0 auto; display: grid; grid-template-columns: 1fr; gap: 1.5rem; padding: 0 1rem; }
  @media (min-width: 768px) { .voting-container { grid-template-columns: 1fr 1fr; } }

  .input-label { display: block; margin-bottom: 8px; color: #d4d4d8; font-size: 0.9rem; font-weight: 500; }

  .participant-search { margin-bottom: 1rem; }

  .participants-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(90px, 1fr)); gap: 0.6rem;
    max-height: 320px; overflow-y: auto; padding: 0.5rem; margin-bottom: 0.5rem;
    background: rgba(0,0,0,0.25); border-radius: 12px; border: 1px solid rgba(255,255,255,0.08);
  }
  .participant-option {
    display: flex; flex-direction: column; align-items: center; gap: 0.35rem; padding: 0.5rem;
    border-radius: 10px; border: 2px solid transparent; cursor: pointer; text-align: center;
    transition: all 0.2s ease; background: rgba(255,255,255,0.03);
  }
  .participant-option:hover { background: rgba(255,255,255,0.08); }
  .participant-option input { opacity: 0; width: 0; height: 0; position: absolute; }
  .participant-option.selected { border-color: var(--gold, #D4AF37); background: rgba(212, 175, 55, 0.15); }
  .participant-option:has(input:disabled) { opacity: 0.35; cursor: not-allowed; }
  .participant-photo { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; border: 1px solid rgba(255,255,255,0.2); }
  .participant-label-name { font-size: 0.72rem; color: #e4e4e7; line-height: 1.1; word-break: break-word; }
  .blank-option { border-style: dashed; border-color: rgba(255,255,255,0.15); }
  .blank-option .blank-icon { font-size: 1.6rem; }

  .submit-section { max-width: 800px; margin: 2rem auto 0 auto; padding: 0 1rem; }

  .notification {
    position: fixed; top: 20px; left: 50%; transform: translateX(-50%);
    background: #4ade80; color: #064e3b; padding: 12px 24px; border-radius: 30px;
    font-weight: bold; box-shadow: 0 4px 15px rgba(74, 222, 128, 0.4); z-index: 1000;
    transition: opacity 0.5s ease, top 0.5s ease;
  }
  .hidden { opacity: 0; pointer-events: none; top: -50px; }
  .show { opacity: 1; top: 20px; }

  .footer-admin { text-align: center; margin-top: 4rem; padding-bottom: 2rem; }
  .admin-link { color: rgba(255, 255, 255, 0.3); text-decoration: none; font-size: 0.85rem; transition: color 0.3s ease; }
  .admin-link:hover { color: var(--gold, #D4AF37); }
  .credit-line { color: rgba(255, 255, 255, 0.15); font-size: 0.72rem; margin-top: 0.8rem; letter-spacing: 0.5px; }
  .empty-categories { text-align: center; color: #a1a1aa; padding: 2rem; }
</style>
