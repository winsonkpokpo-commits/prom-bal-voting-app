---
import Layout from '../components/Layout.astro';
import GlassCard from '../components/GlassCard.astro';
import GoldButton from '../components/GoldButton.astro';
import { supabase } from '../lib/supabase';

const { data: categoriesData } = await supabase
  .from('categories')
  .select('name')
  .order('position', { ascending: true });

const categories = (categoriesData || []).map(c => c.name);
---

<Layout title="Bal Masqué 2026 - CPEG Ste Bakhita">

  <div id="success-notification" class="notification hidden">
    ✅ Votre vote a bien été enregistré !
  </div>

  <div class="hero-section">
    <svg viewBox="0 0 200 110" class="custom-mask-icon" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="goldFiligree" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#FFF3B0" />
          <stop offset="30%" stop-color="#D4AF37" />
          <stop offset="70%" stop-color="#AA7C11" />
          <stop offset="100%" stop-color="#FFD700" />
        </linearGradient>

        <radialGradient id="maskGlow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#D4AF37" stop-opacity="0.35"/>
          <stop offset="100%" stop-color="#D4AF37" stop-opacity="0"/>
        </radialGradient>

        <filter id="shadow3D" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="0" dy="5" stdDeviation="5" flood-color="#D4AF37" flood-opacity="0.5"/>
        </filter>
      </defs>

      <ellipse cx="100" cy="55" rx="85" ry="45" fill="url(#maskGlow)" />

      <path d="M 100,75 C 85,92 55,95 25,82 C 8,74 -2,55 3,38 C 8,18 32,18 65,30 C 82,36 94,44 100,48 C 106,44 118,36 135,30 C 168,18 192,18 197,38 C 202,55 192,74 175,82 C 145,95 115,92 100,75 Z" 
            fill="#09090C" stroke="url(#goldFiligree)" stroke-width="2.2" filter="url(#shadow3D)" />

      <path d="M 32,54 Q 55,40 78,54 Q 55,68 32,54 Z" fill="#000" stroke="url(#goldFiligree)" stroke-width="1.5" />
      <path d="M 122,54 Q 145,40 168,54 Q 145,68 122,54 Z" fill="#000" stroke="url(#goldFiligree)" stroke-width="1.5" />

      <path d="M 100,12 L 106,28 L 100,24 L 94,28 Z" fill="url(#goldFiligree)" />
      <path d="M 100,5 L 109,24 L 100,20 L 91,24 Z" fill="url(#goldFiligree)" opacity="0.8" />
      <circle cx="100" cy="4" r="2.5" fill="#FFFFFF" />

      <path d="M 100,28 C 82,12 55,10 30,20 C 15,25 8,30 5,18 C 22,8 55,8 85,22 Z" fill="url(#goldFiligree)" opacity="0.85" />
      <path d="M 28,26 C 45,18 68,22 80,32" stroke="url(#goldFiligree)" stroke-width="1.2" fill="none" />
      <path d="M 18,44 C 10,36 12,26 22,28 M 12,58 C 4,50 6,38 18,42" stroke="url(#goldFiligree)" stroke-width="1.2" fill="none" />

      <path d="M 100,28 C 118,12 145,10 170,20 C 185,25 192,30 195,18 C 178,8 145,8 115,22 Z" fill="url(#goldFiligree)" opacity="0.85" />
      <path d="M 172,26 C 155,18 132,22 120,32" stroke="url(#goldFiligree)" stroke-width="1.2" fill="none" />
      <path d="M 182,44 C 190,36 188,26 178,28 M 188,58 C 196,50 194,38 182,42" stroke="url(#goldFiligree)" stroke-width="1.2" fill="none" />

      <path d="M 48,76 C 32,80 18,72 24,62 C 28,55 40,60 46,68" stroke="url(#goldFiligree)" stroke-width="1.2" fill="none" />
      <path d="M 152,76 C 168,80 182,72 176,62 C 172,55 160,60 154,68" stroke="url(#goldFiligree)" stroke-width="1.2" fill="none" />

      <path d="M 100,48 L 96,65 L 100,70 L 104,65 Z" fill="url(#goldFiligree)" />
    </svg>

    <span class="school-badge">CPEG Ste Bakhita</span>
    <h1>Le Bal Masqué 2026</h1>
    <p class="subtitle">L'anonymat tombe le temps d'une nuit... Élisez les rois et reines de la soirée.</p>
  </div>

  <div class="voting-container">
    {categories.map((category) => (
      <GlassCard title={category}>
        <form action="/api/vote" method="POST">
          <input type="hidden" name="category" value={category} />
          <label class="input-label">Votre nom complet :</label>
          <input type="text" name="voter_name" class="voter-name-input" placeholder="Ex: Marie Dupont" required />
          <label class="input-label">Votre favori(te) :</label>
          <input type="text" name="voted_for" placeholder="Entrez un nom complet..." required />
          <GoldButton text="Valider mon vote" type="submit" />
        </form>
      </GlassCard>
    ))}
  </div>

  <div class="footer-admin">
    <a href="/admin" class="admin-link">🔒 Administration</a>
  </div>

</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // --- Le votant tape son nom une seule fois, il se propage aux 4 formulaires ---
    const nameInputs = document.querySelectorAll('.voter-name-input');
    const COOKIE_NAME = 'voter_name';

    const getCookie = (key) => {
      const match = document.cookie.match(new RegExp('(?:^|; )' + key + '=([^;]*)'));
      return match ? decodeURIComponent(match[1]) : '';
    };
    const setCookie = (key, value) => {
      document.cookie = `${key}=${encodeURIComponent(value)}; path=/; max-age=86400; SameSite=Lax`;
    };

    const savedName = getCookie(COOKIE_NAME);
    if (savedName) {
      nameInputs.forEach(input => { input.value = savedName; });
    }

    nameInputs.forEach(input => {
      input.addEventListener('input', () => {
        setCookie(COOKIE_NAME, input.value);
        nameInputs.forEach(other => {
          if (other !== input) other.value = input.value;
        });
      });
    });

    // --- Message de succès / erreur après redirection depuis /api/vote ---
    const params = new URLSearchParams(window.location.search);
    const notif = document.getElementById('success-notification');

    if (params.get('success') === '1' && notif) {
      notif.classList.remove('hidden');
      notif.classList.add('show');
      setTimeout(() => {
        notif.classList.remove('show');
        notif.classList.add('hidden');
      }, 4000);
      window.history.replaceState({}, '', '/');
    }

    const errorType = params.get('error');
    if (errorType) {
      let message = "Une erreur est survenue lors de l'envoi de votre vote. Merci de réessayer.";
      if (errorType === 'deja_vote') {
        message = "Vous avez déjà voté dans cette catégorie.";
      } else if (errorType === 'champs_manquants' || errorType === 'nom_invalide') {
        message = "Merci de remplir votre nom et votre vote avant de valider.";
      }
      alert(message);
      window.history.replaceState({}, '', '/');
    }
  });
</script>

<style>
  .hero-section {
    text-align: center;
    padding: 2rem 1rem 1.5rem 1rem;
    position: relative;
  }

  .custom-mask-icon {
    width: 150px;
    height: auto;
    margin: 0 auto 1rem auto;
    display: block;
    animation: float-mask 4s ease-in-out infinite;
  }

  @keyframes float-mask {
    0% { transform: translateY(0px) scale(1); }
    50% { transform: translateY(-7px) scale(1.02); }
    100% { transform: translateY(0px) scale(1); }
  }

  .school-badge {
    display: inline-block;
    background: rgba(245, 208, 97, 0.1);
    color: var(--gold, #D4AF37);
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    border: 1px solid rgba(245, 208, 97, 0.3);
    margin-bottom: 1rem;
  }

  .hero-section h1 {
    font-size: 2.2rem;
    background: linear-gradient(135deg, #fff 30%, var(--gold, #D4AF37) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: #a1a1aa;
    font-size: 0.95rem;
    max-width: 400px;
    margin: 0 auto 2rem auto;
    line-height: 1.5;
  }

  .voting-container {
    max-width: 800px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    padding: 0 1rem;
  }
  @media (min-width: 768px) {
    .voting-container { grid-template-columns: 1fr 1fr; }
  }

  .input-label {
    display: block;
    margin-bottom: 8px;
    color: #d4d4d8;
    font-size: 0.9rem;
    font-weight: 500;
  }

  input[type="text"] {
    width: 100%;
    padding: 12px;
    margin-bottom: 1rem;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: #fff;
    box-sizing: border-box;
  }
  input[type="text"]:focus {
    outline: none;
    border-color: var(--gold, #D4AF37);
  }

  .notification {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: #4ade80;
    color: #064e3b;
    padding: 12px 24px;
    border-radius: 30px;
    font-weight: bold;
    box-shadow: 0 4px 15px rgba(74, 222, 128, 0.4);
    z-index: 1000;
    transition: opacity 0.5s ease, top 0.5s ease;
  }
  .hidden { opacity: 0; pointer-events: none; top: -50px; }
  .show { opacity: 1; top: 20px; }

  .footer-admin {
    text-align: center;
    margin-top: 4rem;
    padding-bottom: 2rem;
  }

  .admin-link {
    color: rgba(255, 255, 255, 0.3);
    text-decoration: none;
    font-size: 0.85rem;
    transition: color 0.3s ease;
  }

  .admin-link:hover {
    color: var(--gold, #D4AF37);
  }
</style>
