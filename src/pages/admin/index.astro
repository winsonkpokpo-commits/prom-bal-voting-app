---
import Layout from '../../components/Layout.astro';
import GlassCard from '../../components/GlassCard.astro';
import GoldButton from '../../components/GoldButton.astro';
---

<Layout title="Administration - CPEG Ste Bakhita">
  <div class="admin-login-container">
    <div class="mask-icon">🎭</div>
    <h1>CPEG Ste Bakhita</h1>
    <h2>Espace Réservé</h2>

    <GlassCard>
      <form id="admin-login-form">
        <label class="input-label">Code d'accès secret :</label>
        <input
          type="password"
          name="password"
          id="admin-password"
          placeholder="Entrez le code..."
          required
        />

        <p class="error-text" id="admin-error" style="display: none;"></p>

        <GoldButton text="Déverrouiller" type="submit" />
      </form>

      <div class="back-link">
        <a href="/">← Retour au site public</a>
      </div>
    </GlassCard>
  </div>
</Layout>

<script is:inline>
  document.getElementById('admin-login-form').addEventListener('submit', async (e) => {
    e.preventDefault();

    const errorEl = document.getElementById('admin-error');
    const passwordInput = document.getElementById('admin-password');
    const submitBtn = e.target.querySelector('button[type="submit"]');

    errorEl.style.display = 'none';
    submitBtn.disabled = true;

    try {
      const res = await fetch('/api/admin/unlock', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code: passwordInput.value })
      });

      const data = await res.json();

      if (res.ok && data.success) {
        window.location.href = '/admin/results';
      } else {
        errorEl.textContent = data.error || 'Code incorrect.';
        errorEl.style.display = 'block';
        submitBtn.disabled = false;
      }
    } catch (err) {
      errorEl.textContent = 'Erreur de connexion au serveur.';
      errorEl.style.display = 'block';
      submitBtn.disabled = false;
    }
  });
</script>

<style>
  .admin-login-container {
    max-width: 420px;
    margin: 4rem auto;
    text-align: center;
  }

  .mask-icon {
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: 1.5rem;
    color: #fff;
    margin-bottom: 0.2rem;
  }

  h2 {
    font-size: 1.1rem;
    color: var(--gold);
    margin-bottom: 2rem;
  }

  .input-label {
    display: block;
    text-align: left;
    margin-bottom: 8px;
    color: #d4d4d8;
    font-size: 0.9rem;
  }

  .error-text {
    color: #ef4444;
    background: rgba(239, 68, 68, 0.1);
    padding: 10px;
    border-radius: 8px;
    font-size: 0.85rem;
    margin-bottom: 1rem;
    border: 1px solid rgba(239, 68, 68, 0.2);
  }

  .back-link {
    margin-top: 1.5rem;
    text-align: center;
  }

  .back-link a {
    color: #a1a1aa;
    text-decoration: none;
    font-size: 0.85rem;
    transition: color 0.3s;
  }

  .back-link a:hover {
    color: var(--gold);
  }
</style>
