
---
import Layout from '../../components/Layout.astro';
import GlassCard from '../../components/GlassCard.astro';
import { isAdminAuthenticated } from '../../lib/admin-auth';

if (!isAdminAuthenticated(Astro)) {
  return Astro.redirect('/admin/login');
}
---

<Layout title="Administration - Bal Masqué 2026">
  <div class="admin-header">
    <svg viewBox="0 0 200 110" class="admin-mask-icon" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="goldFiligree" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#FFF3B0" />
          <stop offset="30%" stop-color="#D4AF37" />
          <stop offset="70%" stop-color="#AA7C11" />
          <stop offset="100%" stop-color="#FFD700" />
        </linearGradient>
        <radialGradient id="maskGlow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#D4AF37" stop-opacity="0.35"/>
          <stop offset="100%" stop-color="#D4AF37" stop-opacity="0"/>
        </radialGradient>
        <filter id="shadow3D" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="0" dy="5" stdDeviation="5" flood-color="#D4AF37" flood-opacity="0.5"/>
        </filter>
      </defs>
      <ellipse cx="100" cy="55" rx="85" ry="45" fill="url(#maskGlow)" />
      <path d="M 100,75 C 85,92 55,95 25,82 C 8,74 -2,55 3,38 C 8,18 32,18 65,30 C 82,36 94,44 100,48 C 106,44 118,36 135,30 C 168,18 192,18 197,38 C 202,55 192,74 175,82 C 145,95 115,92 100,75 Z" fill="#09090C" stroke="url(#goldFiligree)" stroke-width="2.2" filter="url(#shadow3D)" />
      <path d="M 32,54 Q 55,40 78,54 Q 55,68 32,54 Z" fill="#000" stroke="url(#goldFiligree)" stroke-width="1.5" />
      <path d="M 122,54 Q 145,40 168,54 Q 145,68 122,54 Z" fill="#000" stroke="url(#goldFiligree)" stroke-width="1.5" />
    </svg>

    <h1>Espace d'Administration</h1>
    <p class="subtitle">Gestion de la liste des participants et des catégories</p>

    <div class="header-nav">
      <a href="/" class="back-link">← Retour au site principal</a>
      <button id="logout-btn" class="logout-link">🚪 Se déconnecter</button>
    </div>
  </div>

  <div id="global-error" class="global-error hidden"></div>

  <div class="admin-grid">
    <GlassCard title="✍️ Ajouter / Modifier un Participant">
      <p class="hint-text">Cette liste est commune à toutes les catégories : chaque participant du bal n'est ajouté qu'une seule fois ici, puis peut être élu dans n'importe quelle catégorie.</p>
      <form id="participant-form" class="form-container">
        <input type="hidden" id="edit-participant-id" name="id" value="" />

        <div id="edit-badge" class="edit-mode-badge hidden">
          ✏️ Mode ÉDITION actif <button type="button" id="cancel-edit-btn" class="cancel-edit">Annuler</button>
        </div>

        <div class="form-group">
          <label for="name">Nom complet du participant :</label>
          <input type="text" id="name" name="name" placeholder="Ex: Marie Dupont" required />
        </div>

        <div class="form-group">
          <label for="photo">Photo (optionnel) :</label>
          <input type="file" id="photo" name="photo" accept="image/*" />
        </div>

        <button type="submit" id="submit-btn" class="gold-action-btn">➕ Enregistrer le participant</button>
      </form>
    </GlassCard>

    <GlassCard title="📋 Liste des Participants">
      <div id="participants-container" class="participants-list">
        <p class="loading-text">Chargement de la liste...</p>
      </div>
    </GlassCard>
  </div>

  <div class="categories-section">
    <GlassCard title="🏷️ Gérer les Catégories de Vote">
      <form id="category-form" class="category-form">
        <input type="text" id="new-category-name" placeholder="Ex: Le/La plus drôle" required />
        <button type="submit" class="gold-action-btn">➕ Ajouter</button>
      </form>
      <div id="categories-list" class="categories-list">
        <p class="loading-text">Chargement des catégories...</p>
      </div>
    </GlassCard>
  </div>
</Layout>

<script is:inline>
  let isEditing = false;

  function showError(msg) {
    const el = document.getElementById('global-error');
    if (!el) { console.error(msg); return; }
    el.textContent = msg;
    el.classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
    setTimeout(() => el.classList.add('hidden'), 6000);
  }

  document.getElementById('logout-btn')?.addEventListener('click', async () => {
    await fetch('/api/admin/logout', { method: 'POST' });
    window.location.href = '/admin/login';
  });

  // --- PARTICIPANTS ---
  async function loadParticipants() {
    const container = document.getElementById('participants-container');
    if (!container) return;

    try {
      const res = await fetch('/api/admin/participants', { credentials: 'same-origin' });
      if (res.status === 401) { window.location.href = '/admin/login'; return; }
      const data = await res.json();

      if (!res.ok || !data.success) {
        container.innerHTML = '<p class="error-text">Erreur de chargement des données.</p>';
        return;
      }

      container.innerHTML = '';
      if (!data.participants || data.participants.length === 0) {
        container.innerHTML = '<p class="empty-text">Aucun participant enregistré pour le moment.</p>';
        return;
      }

      data.participants.forEach(p => {
        const item = document.createElement('div');
        item.className = 'participant-item';

        const info = document.createElement('div');
        info.className = 'participant-info';

        if (p.photo_url) {
          const img = document.createElement('img');
          img.src = p.photo_url;
          img.className = 'avatar-img';
          img.alt = '';
          info.appendChild(img);
        } else {
          const placeholder = document.createElement('div');
          placeholder.className = 'avatar-placeholder';
          placeholder.textContent = (p.name || '?').charAt(0).toUpperCase();
          info.appendChild(placeholder);
        }

        const nameEl = document.createElement('h4');
        nameEl.className = 'participant-name';
        nameEl.textContent = p.name;
        info.appendChild(nameEl);

        const actions = document.createElement('div');
        actions.className = 'actions-group';

        const editBtn = document.createElement('button');
        editBtn.type = 'button';
        editBtn.className = 'btn-edit';
        editBtn.title = 'Éditer';
        editBtn.textContent = '✏️';
        editBtn.dataset.id = p.id;
        editBtn.dataset.name = p.name;

        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'btn-delete';
        delBtn.title = 'Supprimer';
        delBtn.textContent = '🗑️';
        delBtn.dataset.id = p.id;
        delBtn.dataset.name = p.name;

        actions.appendChild(editBtn);
        actions.appendChild(delBtn);
        item.appendChild(info);
        item.appendChild(actions);
        container.appendChild(item);
      });
    } catch (e) {
      container.innerHTML = '<p class="error-text">Impossible de contacter le serveur.</p>';
    }
  }

  document.getElementById('participants-container')?.addEventListener('click', (e) => {
    const editBtn = e.target.closest('.btn-edit');
    const delBtn = e.target.closest('.btn-delete');
    if (editBtn) startEdit(editBtn.dataset.id, editBtn.dataset.name);
    else if (delBtn) deleteParticipant(delBtn.dataset.id, delBtn.dataset.name);
  });

  function startEdit(id, name) {
    isEditing = true;
    document.getElementById('edit-participant-id').value = id;
    document.getElementById('name').value = name;
    document.getElementById('submit-btn').textContent = '💾 Enregistrer les modifications';
    document.getElementById('edit-badge').classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function resetForm() {
    isEditing = false;
    document.getElementById('participant-form').reset();
    document.getElementById('edit-participant-id').value = '';
    document.getElementById('submit-btn').textContent = '➕ Enregistrer le participant';
    document.getElementById('edit-badge').classList.add('hidden');
  }
  document.getElementById('cancel-edit-btn')?.addEventListener('click', resetForm);

  async function deleteParticipant(id, name) {
    if (!confirm(`Voulez-vous vraiment supprimer "${name}" ? Ses votes seront également supprimés.`)) return;
    try {
      const res = await fetch(`/api/admin/participants?id=${encodeURIComponent(id)}`, {
        method: 'DELETE',
        credentials: 'same-origin'
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success) loadParticipants();
      else showError(data.error || "Erreur lors de la suppression.");
    } catch (e) {
      showError("Erreur de connexion au serveur.");
    }
  }

  document.getElementById('participant-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const method = isEditing ? 'PUT' : 'POST';

    try {
      const res = await fetch('/api/admin/participants', { method, body: formData, credentials: 'same-origin' });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success) { resetForm(); loadParticipants(); }
      else showError(data.error || "Une erreur est survenue.");
    } catch (err) {
      showError("Erreur réseau, vérifiez votre connexion.");
    }
  });

  // --- CATÉGORIES ---
  async function loadCategories() {
    const listEl = document.getElementById('categories-list');
    if (!listEl) return;

    try {
      const res = await fetch('/api/admin/categories', { credentials: 'same-origin' });
      if (res.status === 401) { window.location.href = '/admin/login'; return; }
      const data = await res.json();

      if (!res.ok || !data.success) {
        listEl.innerHTML = '<p class="error-text">Erreur de chargement des catégories.</p>';
        return;
      }

      listEl.innerHTML = '';
      const cats = data.categories || [];
      if (cats.length === 0) {
        listEl.innerHTML = '<p class="empty-text">Aucune catégorie pour le moment.</p>';
        return;
      }

      cats.forEach(cat => {
        const item = document.createElement('div');
        item.className = 'category-item';

        const span = document.createElement('span');
        span.textContent = cat.name;

        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'btn-delete';
        delBtn.title = 'Supprimer';
        delBtn.textContent = '🗑️';
        delBtn.dataset.id = cat.id;
        delBtn.dataset.name = cat.name;

        item.appendChild(span);
        item.appendChild(delBtn);
        listEl.appendChild(item);
      });
    } catch (e) {
      listEl.innerHTML = '<p class="error-text">Impossible de contacter le serveur.</p>';
    }
  }

  document.getElementById('categories-list')?.addEventListener('click', async (e) => {
    const delBtn = e.target.closest('.btn-delete');
    if (!delBtn) return;
    const { id, name } = delBtn.dataset;
    if (!confirm(`Supprimer la catégorie "${name}" ? Les votes associés seront aussi supprimés.`)) return;

    try {
      const res = await fetch(`/api/admin/categories?id=${encodeURIComponent(id)}`, {
        method: 'DELETE',
        credentials: 'same-origin'
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success) loadCategories();
      else showError(data.error || "Erreur lors de la suppression.");
    } catch (e2) {
      showError("Erreur de connexion.");
    }
  });

  document.getElementById('category-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = document.getElementById('new-category-name');
    const name = input.value.trim();
    if (!name) return;

    try {
      const res = await fetch('/api/admin/categories', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ name })
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success) { input.value = ''; loadCategories(); }
      else showError(data.error || "Une erreur est survenue.");
    } catch (err) {
      showError("Erreur réseau.");
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    loadParticipants();
    loadCategories();
  });
</script>

<style>
  .admin-header { text-align: center; padding: 2rem 1rem 1rem 1rem; }
  .admin-mask-icon { width: 120px; height: auto; margin: 0 auto 1rem auto; display: block; }
  .admin-header h1 { font-size: 2rem; color: #fff; margin-bottom: 0.2rem; }
  .subtitle { color: #a1a1aa; font-size: 0.95rem; margin-bottom: 1rem; }

  .header-nav { display: flex; justify-content: center; align-items: center; gap: 1.5rem; }
  .back-link { color: #D4AF37; text-decoration: none; font-size: 0.85rem; font-weight: bold; }
  .logout-link { background: transparent; border: 1px solid #ef4444; color: #ef4444; padding: 4px 10px; border-radius: 6px; cursor: pointer; font-size: 0.85rem; }
  .logout-link:hover { background: rgba(239, 68, 68, 0.2); }

  .global-error {
    max-width: 1000px; margin: 0 auto 1rem auto; padding: 12px 16px;
    background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; color: #fecaca;
    border-radius: 8px; font-size: 0.9rem;
  }

  .hint-text { color: #a1a1aa; font-size: 0.82rem; margin-top: -0.5rem; margin-bottom: 1rem; }

  .admin-grid { max-width: 1000px; margin: 2rem auto; display: grid; grid-template-columns: 1fr; gap: 2rem; padding: 0 1rem; }
  @media (min-width: 850px) { .admin-grid { grid-template-columns: 1fr 1fr; } }

  .categories-section { max-width: 1000px; margin: 0 auto 2rem auto; padding: 0 1rem; }
  .category-form { display: flex; gap: 0.6rem; margin-bottom: 1.2rem; }
  .category-form input { flex: 1; margin-bottom: 0; }
  .category-form button { width: auto; padding: 10px 16px; margin-top: 0; white-space: nowrap; }
  .categories-list { display: flex; flex-direction: column; gap: 0.6rem; max-height: 300px; overflow-y: auto; }
  .category-item {
    display: flex; align-items: center; justify-content: space-between;
    background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 8px 12px; border-radius: 8px; font-size: 0.9rem; color: #fff;
  }

  .form-container { display: flex; flex-direction: column; gap: 1.2rem; }
  .form-group { display: flex; flex-direction: column; gap: 0.4rem; }
  .form-group label { font-size: 0.85rem; color: #d4d4d8; font-weight: 500; }

  input[type="text"], input[type="file"] {
    width: 100%; padding: 10px 12px; background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 8px; color: #fff; box-sizing: border-box;
  }

  .gold-action-btn {
    background: linear-gradient(135deg, #D4AF37 0%, #AA7C11 100%);
    color: #000; font-weight: bold; padding: 12px; border: none; border-radius: 8px; cursor: pointer;
  }

  .edit-mode-badge {
    background: rgba(212, 175, 55, 0.2); border: 1px solid #D4AF37; color: #D4AF37;
    padding: 8px 12px; border-radius: 6px; font-size: 0.85rem; display: flex; justify-content: space-between;
  }
  .cancel-edit { background: transparent; border: none; color: #ef4444; cursor: pointer; text-decoration: underline; }

  .participants-list { display: flex; flex-direction: column; gap: 0.8rem; max-height: 500px; overflow-y: auto; }
  .participant-item {
    display: flex; align-items: center; justify-content: space-between;
    background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 10px 14px; border-radius: 10px;
  }
  .participant-info { display: flex; align-items: center; gap: 12px; }
  .avatar-img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; border: 1px solid #D4AF37; }
  .avatar-placeholder {
    width: 40px; height: 40px; border-radius: 50%;
    background: linear-gradient(135deg, #D4AF37, #856100);
    color: #000; font-weight: bold; display: flex; align-items: center; justify-content: center;
  }
  .participant-name { margin: 0; font-size: 0.95rem; color: #fff; }

  .actions-group { display: flex; gap: 6px; }
  .btn-edit, .btn-delete {
    background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 6px 10px; border-radius: 6px; cursor: pointer;
  }

  .loading-text, .empty-text, .error-text { text-align: center; color: #a1a1aa; font-size: 0.9rem; padding: 1rem; }
  .hidden { display: none !important; }
</style>
