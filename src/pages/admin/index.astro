---
import Layout from '../../components/Layout.astro';
import GlassCard from '../../components/GlassCard.astro';
import { isAdminAuthenticated } from '../../lib/admin-auth';

if (!isAdminAuthenticated(Astro)) {
  return Astro.redirect('/admin/login');
}
---

<Layout title="Administration - Bal Masqué 2026">
  <div class="admin-header">
    <svg viewBox="0 0 200 110" class="admin-mask-icon" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="goldFiligree" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#FFF3B0" />
          <stop offset="30%" stop-color="#D4AF37" />
          <stop offset="70%" stop-color="#AA7C11" />
          <stop offset="100%" stop-color="#FFD700" />
        </linearGradient>
        <radialGradient id="maskGlow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#D4AF37" stop-opacity="0.35"/>
          <stop offset="100%" stop-color="#D4AF37" stop-opacity="0"/>
        </radialGradient>
        <filter id="shadow3D" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="0" dy="5" stdDeviation="5" flood-color="#D4AF37" flood-opacity="0.5"/>
        </filter>
      </defs>
      <ellipse cx="100" cy="55" rx="85" ry="45" fill="url(#maskGlow)" />
      <path d="M 100,75 C 85,92 55,95 25,82 C 8,74 -2,55 3,38 C 8,18 32,18 65,30 C 82,36 94,44 100,48 C 106,44 118,36 135,30 C 168,18 192,18 197,38 C 202,55 192,74 175,82 C 145,95 115,92 100,75 Z" fill="#09090C" stroke="url(#goldFiligree)" stroke-width="2.2" filter="url(#shadow3D)" />
      <path d="M 32,54 Q 55,40 78,54 Q 55,68 32,54 Z" fill="#000" stroke="url(#goldFiligree)" stroke-width="1.5" />
      <path d="M 122,54 Q 145,40 168,54 Q 145,68 122,54 Z" fill="#000" stroke="url(#goldFiligree)" stroke-width="1.5" />
    </svg>

    <h1>Espace d'Administration</h1>
    <p class="subtitle">Gestion de la liste des participants et des catégories</p>

    <div class="header-nav">
      <a href="/" class="back-link">← Retour au site principal</a>
      <button id="logout-btn" class="logout-link">🚪 Se déconnecter</button>
    </div>
  </div>

  <div id="global-error" class="global-error hidden"></div>

  <div class="voting-control-section">
    <GlassCard title="🗳️ Contrôle du Scrutin">
      <p id="voting-status" class="status-text">Chargement du statut...</p>
      <div class="control-buttons">
        <button id="close-votes-btn" class="btn-warning hidden" type="button">🔒 Fermer les votes</button>
        <button id="reopen-votes-btn" class="btn-success hidden" type="button">🔓 Rouvrir les votes</button>
      </div>
      <div class="danger-zone">
        <p class="danger-label">⚠️ Zone dangereuse</p>
        <button id="reset-votes-btn" class="btn-danger" type="button">🗑️ Réinitialiser tous les votes</button>
        <p class="danger-hint">Supprime définitivement tous les votes enregistrés (et les reçus de vote, pour permettre à tout le monde de revoter). Les participants et catégories restent intacts.</p>
      </div>
    </GlassCard>
  </div>

  <div class="voters-section">
    <GlassCard title="🎓 Électeurs Autorisés">
      <p class="hint-text">Seules les personnes figurant sur cette liste peuvent voter (comparaison insensible aux accents/majuscules). Un nom par ligne — pense à bien orthographier comme les élèves taperont leur nom.</p>
      <form id="voters-form" class="voters-form">
        <textarea id="new-voters-names" rows="4" placeholder="Marie Dupont&#10;Jean Martin&#10;..." required></textarea>
        <button type="submit" class="gold-action-btn">➕ Ajouter à la liste</button>
      </form>
      <div id="voters-list" class="voters-list">
        <p class="loading-text">Chargement de la liste...</p>
      </div>
    </GlassCard>
  </div>

  <div class="admin-grid">
    <GlassCard title="✍️ Ajouter / Modifier un Participant">
      <p class="hint-text">Cette liste est commune à toutes les catégories : chaque participant du bal n'est ajouté qu'une seule fois ici, puis peut être élu dans n'importe quelle catégorie.</p>
      <form id="participant-form" class="form-container">
        <input type="hidden" id="edit-participant-id" name="id" value="" />

        <div id="edit-badge" class="edit-mode-badge hidden">
          ✏️ Mode ÉDITION actif <button type="button" id="cancel-edit-btn" class="cancel-edit">Annuler</button>
        </div>

        <div class="form-group">
          <label for="name">Nom complet du participant :</label>
          <input type="text" id="name" name="name" placeholder="Ex: Marie Dupont" required />
        </div>

        <div class="form-group">
          <label for="photo">Photo (optionnel) :</label>
          <input type="file" id="photo" name="photo" accept="image/*" />
        </div>

        <button type="submit" id="submit-btn" class="gold-action-btn">➕ Enregistrer le participant</button>
      </form>
    </GlassCard>

    <GlassCard title="📋 Liste des Participants">
      <div id="participants-container" class="participants-list">
        <p class="loading-text">Chargement de la liste...</p>
      </div>
    </GlassCard>
  </div>

  <div class="categories-section">
    <GlassCard title="🏷️ Gérer les Catégories de Vote">
      <p class="hint-text">Le nombre de participants définit combien de noms un votant doit choisir dans cette catégorie (1 pour Roi/Reine, 2 pour un duo, etc.).</p>
      <form id="category-form" class="category-form">
        <input type="text" id="new-category-name" placeholder="Ex: Le plus beau duo" required />
        <input type="number" id="new-category-slots" min="1" max="5" value="1" title="Nombre de participants requis" />
        <button type="submit" class="gold-action-btn">➕ Ajouter</button>
      </form>
      <div id="categories-list" class="categories-list">
        <p class="loading-text">Chargement des catégories...</p>
      </div>
    </GlassCard>
  </div>

  <div class="footer-admin-credit">
    <p class="credit-line">Réalisé par Winson KPOKPO en collaboration avec Trésor GNANSOUNOU</p>
  </div>
</Layout>

<script is:inline>
  let isEditing = false;

  function showError(msg) {
    const el = document.getElementById('global-error');
    if (!el) { console.error(msg); return; }
    el.textContent = msg;
    el.classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
    setTimeout(() => el.classList.add('hidden'), 6000);
  }

  document.getElementById('logout-btn')?.addEventListener('click', async () => {
    await fetch('/api/admin/logout', { method: 'POST' });
    window.location.href = '/admin/login';
  });

  // --- CONTRÔLE DU SCRUTIN ---
  async function loadVotingStatus() {
    const statusEl = document.getElementById('voting-status');
    const closeBtn = document.getElementById('close-votes-btn');
    const reopenBtn = document.getElementById('reopen-votes-btn');
    if (!statusEl) return;

    try {
      const res = await fetch('/api/config');
      const data = await res.json();
      const closed = !!data.voting_closed;

      statusEl.textContent = closed
        ? '🔴 Les votes sont actuellement FERMÉS.'
        : '🟢 Les votes sont actuellement OUVERTS.';

      closeBtn?.classList.toggle('hidden', closed);
      reopenBtn?.classList.toggle('hidden', !closed);
    } catch (e) {
      statusEl.textContent = "Impossible de charger le statut des votes.";
    }
  }

  document.getElementById('close-votes-btn')?.addEventListener('click', async () => {
    if (!confirm('Fermer les votes maintenant ? Les électeurs ne pourront plus voter.')) return;
    try {
      const res = await fetch('/api/admin/close-votes', { method: 'POST', credentials: 'same-origin' });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success) loadVotingStatus();
      else showError(data.error || "Erreur lors de la fermeture des votes.");
    } catch (e) {
      showError("Erreur de connexion au serveur.");
    }
  });

  document.getElementById('reopen-votes-btn')?.addEventListener('click', async () => {
    if (!confirm('Rouvrir les votes ?')) return;
    try {
      const res = await fetch('/api/admin/reopen-votes', { method: 'POST', credentials: 'same-origin' });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success) loadVotingStatus();
      else showError(data.error || "Erreur lors de la réouverture des votes.");
    } catch (e) {
      showError("Erreur de connexion au serveur.");
    }
  });

  document.getElementById('reset-votes-btn')?.addEventListener('click', async () => {
    if (!confirm('⚠️ Ceci va supprimer DÉFINITIVEMENT tous les votes enregistrés. Continuer ?')) return;
    if (!confirm('Dernière confirmation : es-tu certain(e) ? Cette action est irréversible.')) return;

    try {
      const res = await fetch('/api/admin/reset-votes', { method: 'POST', credentials: 'same-origin' });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success) {
        alert('Tous les votes ont été réinitialisés.');
      } else {
        showError(data.error || "Erreur lors de la réinitialisation.");
      }
    } catch (e) {
      showError("Erreur de connexion au serveur.");
    }
  });

  // --- ÉLECTEURS AUTORISÉS ---
  async function loadVoters() {
    const listEl = document.getElementById('voters-list');
    if (!listEl) return;

    try {
      const res = await fetch('/api/admin/voters', { credentials: 'same-origin' });
      if (res.status === 401) { window.location.href = '/admin/login'; return; }
      const data = await res.json();

      if (!res.ok || !data.success) {
        listEl.innerHTML = '<p class="error-text">Erreur de chargement.</p>';
        return;
      }

      listEl.innerHTML = '';
      const voters = data.voters || [];
      if (voters.length === 0) {
        listEl.innerHTML = '<p class="empty-text">Aucun électeur enregistré. Le vote est bloqué pour tout le monde tant que cette liste est vide.</p>';
        return;
      }

      const countEl = document.createElement('p');
      countEl.className = 'hint-text';
      countEl.textContent = `${voters.length} électeur(s) enregistré(s).`;
      listEl.appendChild(countEl);

      const wrap = document.createElement('div');
      wrap.className = 'voters-chips';
      voters.forEach((v) => {
        const chip = document.createElement('span');
        chip.className = 'voter-chip';
        chip.textContent = v.name;

        const del = document.createElement('button');
        del.type = 'button';
        del.className = 'chip-delete';
        del.textContent = '×';
        del.title = 'Retirer';
        del.dataset.id = v.id;
        del.dataset.name = v.name;
        chip.appendChild(del);

        wrap.appendChild(chip);
      });
      listEl.appendChild(wrap);
    } catch (e) {
      listEl.innerHTML = '<p class="error-text">Impossible de contacter le serveur.</p>';
    }
  }

  document.getElementById('voters-list')?.addEventListener('click', async (e) => {
    const delBtn = e.target.closest('.chip-delete');
    if (!delBtn) return;
    const { id, name } = delBtn.dataset;
    if (!confirm(`Retirer "${name}" de la liste des électeurs autorisés ?`)) return;

    try {
      const res = await fetch(`/api/admin/voters?id=${encodeURIComponent(id)}`, {
        method: 'DELETE',
        credentials: 'same-origin'
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success) loadVoters();
      else showError(data.error || "Erreur lors de la suppression.");
    } catch (e2) {
      showError("Erreur de connexion.");
    }
  });

  document.getElementById('voters-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const textarea = document.getElementById('new-voters-names');
    const names = textarea.value.trim();
    if (!names) return;

    try {
      const res = await fetch('/api/admin/voters', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ names })
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success) { textarea.value = ''; loadVoters(); }
      else showError(data.error || "Une erreur est survenue.");
    } catch (err) {
      showError("Erreur réseau.");
    }
  });

  // --- PARTICIPANTS ---
  async function loadParticipants() {
    const container = document.getElementById('participants-container');
    if (!container) return;

    try {
      const res = await fetch('/api/admin/participants', { credentials: 'same-origin' });
      if (res.status === 401) { window.location.href = '/admin/login'; return; }
      const data = await res.json();

      if (!res.ok || !data.success) {
        container.innerHTML = '<p class="error-text">Erreur de chargement des données.</p>';
        return;
      }

      container.innerHTML = '';
      if (!data.participants || data.participants.length === 0) {
        container.innerHTML = '<p class="empty-text">Aucun participant enregistré pour le moment.</p>';
        return;
      }

      data.participants.forEach(p => {
        const item = document.createElement('div');
        item.className = 'participant-item';

        const info = document.createElement('div');
        info.className = 'participant-info';

        if (p.photo_url) {
          const img = document.createElement('img');
          img.src = p.photo_url;
          img.className = 'avatar-img';
          img.alt = '';
          info.appendChild(img);
        } else {
          const placeholder = document.createElement('div');
          placeholder.className = 'avatar-placeholder';
          placeholder.textContent = (p.name || '?').charAt(0).toUpperCase();
          info.appendChild(placeholder);
        }

        const nameEl = document.createElement('h4');
        nameEl.className = 'participant-name';
        nameEl.textContent = p.name;
        info.appendChild(nameEl);

        const actions = document.createElement('div');
        actions.className = 'actions-group';

        const editBtn = document.createElement('button');
        editBtn.type = 'button';
        editBtn.className = 'btn-edit';
        editBtn.title = 'Éditer';
        editBtn.textContent = '✏️';
        editBtn.dataset.id = p.id;
        editBtn.dataset.name = p.name;

        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'btn-delete';
        delBtn.title = 'Supprimer';
        delBtn.textContent = '🗑️';
        delBtn.dataset.id = p.id;
        delBtn.dataset.name = p.name;

        actions.appendChild(editBtn);
        actions.appendChild(delBtn);
        item.appendChild(info);
        item.appendChild(actions);
        container.appendChild(item);
      });
    } catch (e) {
      container.innerHTML = '<p class="error-text">Impossible de contacter le serveur.</p>';
    }
  }

  document.getElementById('participants-container')?.addEventListener('click', (e) => {
    const editBtn = e.target.closest('.btn-edit');
    const delBtn = e.target.closest('.btn-delete');
    if (editBtn) startEdit(editBtn.dataset.id, editBtn.dataset.name);
    else if (delBtn) deleteParticipant(delBtn.dataset.id, delBtn.dataset.name);
  });

  function startEdit(id, name) {
    isEditing = true;
    document.getElementById('edit-participant-id').value = id;
    document.getElementById('name').value = name;
    document.getElementById('submit-btn').textContent = '💾 Enregistrer les modifications';
    document.getElementById('edit-badge').classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function resetForm() {
    isEditing = false;
    document.getElementById('participant-form').reset();
    document.getElementById('edit-participant-id').value = '';
    document.getElementById('submit-btn').textContent = '➕ Enregistrer le participant';
    document.getElementById('edit-badge').classList.add('hidden');
  }
  document.getElementById('cancel-edit-btn')?.addEventListener('click', resetForm);

  async function deleteParticipant(id, name) {
    if (!confirm(`Voulez-vous vraiment supprimer "${name}" ? Ses votes seront également supprimés.`)) return;
    try {
      const res = await fetch(`/api/admin/participants?id=${encodeURIComponent(id)}`, {
        method: 'DELETE',
        credentials: 'same-origin'
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success) loadParticipants();
      else showError(data.error || "Erreur lors de la suppression.");
    } catch (e) {
      showError("Erreur de connexion au serveur.");
    }
  }

  document.getElementById('participant-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const method = isEditing ? 'PUT' : 'POST';

    try {
      const res = await fetch('/api/admin/participants', { method, body: formData, credentials: 'same-origin' });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success) { resetForm(); loadParticipants(); }
      else showError(data.error || "Une erreur est survenue.");
    } catch (err) {
      showError("Erreur réseau, vérifiez votre connexion.");
    }
  });

  // --- CATÉGORIES ---
  function renderCategoryItem(cat) {
    const item = document.createElement('div');
    item.className = 'category-item';

    const span = document.createElement('span');
    span.textContent = cat.slots > 1 ? `${cat.name} — ${cat.slots} participants` : cat.name;

    const actions = document.createElement('div');
    actions.className = 'category-actions';

    const editBtn = document.createElement('button');
    editBtn.type = 'button';
    editBtn.className = 'btn-edit';
    editBtn.title = 'Modifier le nombre de participants';
    editBtn.textContent = '✏️';

    const delBtn = document.createElement('button');
    delBtn.type = 'button';
    delBtn.className = 'btn-delete';
    delBtn.title = 'Supprimer';
    delBtn.textContent = '🗑️';
    delBtn.dataset.id = cat.id;
    delBtn.dataset.name = cat.name;

    actions.appendChild(editBtn);
    actions.appendChild(delBtn);
    item.appendChild(span);
    item.appendChild(actions);

    editBtn.addEventListener('click', () => {
      if (item.querySelector('.category-edit-form')) return;

      const editForm = document.createElement('div');
      editForm.className = 'category-edit-form';

      const slotsInput = document.createElement('input');
      slotsInput.type = 'number';
      slotsInput.min = '1';
      slotsInput.max = '5';
      slotsInput.value = cat.slots || 1;

      const saveBtn = document.createElement('button');
      saveBtn.type = 'button';
      saveBtn.textContent = '💾';

      const cancelBtn = document.createElement('button');
      cancelBtn.type = 'button';
      cancelBtn.textContent = '✖️';

      editForm.appendChild(slotsInput);
      editForm.appendChild(saveBtn);
      editForm.appendChild(cancelBtn);
      item.appendChild(editForm);
      span.style.display = 'none';
      actions.style.display = 'none';

      cancelBtn.addEventListener('click', () => {
        editForm.remove();
        span.style.display = '';
        actions.style.display = '';
      });

      saveBtn.addEventListener('click', async () => {
        const newSlots = parseInt(slotsInput.value, 10) || 1;
        try {
          const res = await fetch('/api/admin/categories', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ id: cat.id, slots: newSlots })
          });
          const data = await res.json().catch(() => ({}));
          if (res.ok && data.success) loadCategories();
          else showError(data.error || "Erreur lors de la modification.");
        } catch (e) {
          showError("Erreur réseau.");
        }
      });
    });

    return item;
  }

  async function loadCategories() {
    const listEl = document.getElementById('categories-list');
    if (!listEl) return;

    try {
      const res = await fetch('/api/admin/categories', { credentials: 'same-origin' });
      if (res.status === 401) { window.location.href = '/admin/login'; return; }
      const data = await res.json();

      if (!res.ok || !data.success) {
        listEl.innerHTML = '<p class="error-text">Erreur de chargement des catégories.</p>';
        return;
      }

      listEl.innerHTML = '';
      const cats = data.categories || [];
      if (cats.length === 0) {
        listEl.innerHTML = '<p class="empty-text">Aucune catégorie pour le moment.</p>';
        return;
      }

      cats.forEach(cat => listEl.appendChild(renderCategoryItem(cat)));
    } catch (e) {
      listEl.innerHTML = '<p class="error-text">Impossible de contacter le serveur.</p>';
    }
  }

  document.getElementById('categories-list')?.addEventListener('click', async (e) => {
    const delBtn = e.target.closest('.btn-delete');
    if (!delBtn) return;
    const { id, name } = delBtn.dataset;
    if (!confirm(`Supprimer la catégorie "${name}" ? Les votes associés seront aussi supprimés.`)) return;

    try {
      const res = await fetch(`/api/admin/categories?id=${encodeURIComponent(id)}`, {
        method: 'DELETE',
        credentials: 'same-origin'
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success) loadCategories();
      else showError(data.error || "Erreur lors de la suppression.");
    } catch (e2) {
      showError("Erreur de connexion.");
    }
  });

  document.getElementById('category-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = document.getElementById('new-category-name');
    const slotsInput = document.getElementById('new-category-slots');
    const name = input.value.trim();
    const slots = parseInt(slotsInput.value, 10) || 1;
    if (!name) return;

    try {
      const res = await fetch('/api/admin/categories', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ name, slots })
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success) { input.value = ''; slotsInput.value = '1'; loadCategories(); }
      else showError(data.error || "Une erreur est survenue.");
    } catch (err) {
      showError("Erreur réseau.");
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    loadVotingStatus();
    loadVoters();
    loadParticipants();
    loadCategories();
  });
</script>

<style>
  .admin-header { text-align: center; padding: 2rem 1rem 1rem 1rem; }
  .admin-mask-icon { width: 120px; height: auto; margin: 0 auto 1rem auto; display: block; }
  .admin-header h1 { font-size: 2rem; color: #fff; margin-bottom: 0.2rem; }
  .subtitle { color: #a1a1aa; font-size: 0.95rem; margin-bottom: 1rem; }

  .header-nav { display: flex; justify-content: center; align-items: center; gap: 1.5rem; }
  .back-link { color: #D4AF37; text-decoration: none; font-size: 0.85rem; font-weight: bold; }
  .logout-link { background: transparent; border: 1px solid #ef4444; color: #ef4444; padding: 4px 10px; border-radius: 6px; cursor: pointer; font-size: 0.85rem; }
  .logout-link:hover { background: rgba(239, 68, 68, 0.2); }

  .global-error {
    max-width: 1000px; margin: 0 auto 1rem auto; padding: 12px 16px;
    background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; color: #fecaca;
    border-radius: 8px; font-size: 0.9rem;
  }

  .voting-control-section { max-width: 1000px; margin: 0 auto 2rem auto; padding: 0 1rem; }
  .status-text { text-align: center; font-size: 1rem; color: #fff; margin-bottom: 1rem; font-weight: 600; }
  .control-buttons { display: flex; gap: 1rem; margin-bottom: 1.5rem; }
  .control-buttons button { flex: 1; }
  .btn-warning { background: linear-gradient(135deg, #f59e0b, #d97706) !important; color: #000 !important; }
  .btn-success { background: linear-gradient(135deg, #4ade80, #16a34a) !important; color: #000 !important; }
  .danger-zone {
    border-top: 1px solid rgba(239, 68, 68, 0.3); padding-top: 1.2rem; margin-top: 0.5rem; text-align: center;
  }
