---
import Layout from '../../components/Layout.astro';
import GlassCard from '../../components/GlassCard.astro';
import GoldButton from '../../components/GoldButton.astro';

let errorMessage = "";

if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();
    const password = data.get("password");

    // Vérification avec la clé secrète configurée dans Vercel
    if (password === import.meta.env.ADMIN_SECRET_KEY) {
      // Redirection vers le tableau de bord ou stockage d'une session simple
      return Astro.redirect("/admin/results"); // ou la page de gestion admin
    } else {
      errorMessage = "Mot de passe incorrect.";
    }
  } catch (error) {
    errorMessage = "Erreur de connexion au serveur.";
  }
}
---

<Layout title="Administration - CPEG Ste Bakhita">
  <div class="admin-login-container">
    <div class="mask-icon">🎭</div>
    <h1>CPEG Ste Bakhita</h1>
    <h2>Espace Réservé</h2>

    <GlassCard>
      <form method="POST">
        <label class="input-label">Code d'accès secret :</label>
        <input 
          type="password" 
          name="password" 
          placeholder="Entrez le code..." 
          required 
        />
        
        {errorMessage && <p class="error-text">{errorMessage}</p>}
        
        <GoldButton text="Dévérrouiller" type="submit" />
      </form>

      <div class="back-link">
        <a href="/">← Retour au site public</a>
      </div>
    </GlassCard>
  </div>
</Layout>

<style>
  .admin-login-container {
    max-width: 420px;
    margin: 4rem auto;
    text-align: center;
  }

  .mask-icon {
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: 1.5rem;
    color: #fff;
    margin-bottom: 0.2rem;
  }

  h2 {
    font-size: 1.1rem;
    color: var(--gold);
    margin-bottom: 2rem;
  }

  .input-label {
    display: block;
    text-align: left;
    margin-bottom: 8px;
    color: #d4d4d8;
    font-size: 0.9rem;
  }

  .error-text {
    color: #ef4444; /* Rouge vif moderne */
    background: rgba(239, 68, 68, 0.1);
    padding: 10px;
    border-radius: 8px;
    font-size: 0.85rem;
    margin-bottom: 1rem;
    border: 1px solid rgba(239, 68, 68, 0.2);
  }

  .back-link {
    margin-top: 1.5rem;
    text-align: center;
  }

  .back-link a {
    color: #a1a1aa;
    text-decoration: none;
    font-size: 0.85rem;
    transition: color 0.3s;
  }

  .back-link a:hover {
    color: var(--gold);
  }
</style>
