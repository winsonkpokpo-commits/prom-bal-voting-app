---
import Layout from '../../components/Layout.astro';
import GlassCard from '../../components/GlassCard.astro';
import GoldButton from '../../components/GoldButton.astro';
import { requireAdminSession } from '../../lib/admin-auth';

const isAuthenticated = requireAdminSession(Astro);
---

<Layout title="Administration - CPEG Ste Bakhita">
  <div class="admin-container">
    {!isAuthenticated ? (
      /* --- FORMULAIRE DE CONNEXION --- */
      <div class="login-box">
        <div class="mask-icon">🎭</div>
        <h1>Espace d'Administration</h1>
        <p class="subtitle">Entrez le code secret pour gérer le bal</p>

        <GlassCard>
          <form id="admin-login-form">
            <label class="input-label">Code d'accès :</label>
            <input type="password" id="admin-password" placeholder="Code secret..." required />
            <p class="error-text" id="login-error" style="display: none;"></p>
            <GoldButton text="Se connecter" type="submit" />
          </form>
        </GlassCard>
      </div>
    ) : (
      /* --- PANNEAU DE GESTION --- */
      <div class="dashboard-box">
        <div class="admin-header">
          <h1>⚙️ Gestion du Bal Masqué</h1>
          <div class="header-btns">
            <a href="/results" target="_blank" class="btn-outline">👁️ Voir Résultats Publics</a>
            <button id="logout-btn" class="btn-danger">Déconnexion</button>
          </div>
        </div>

        <GlassCard title="➕ Ajouter un(e) Candidat(e)">
          <form id="add-candidate-form" class="form-grid">
            <div class="form-group">
              <label>Nom & Prénom :</label>
              <input type="text" id="candidate-name" placeholder="Ex: Marie KPOKPO" required />
            </div>

            <div class="form-group">
              <label>Catégorie :</label>
              <select id="candidate-category" required>
                <option value="Roi du Bal">Roi du Bal</option>
                <option value="Reine du Bal">Reine du Bal</option>
                <option value="Le/La plus élégant(e)">Le/La plus élégant(e)</option>
                <option value="Le duo de la soirée">Le duo de la soirée</option>
              </select>
            </div>

            <div class="form-group full-width">
              <label>Photo du candidat (Optionnel) :</label>
              <input type="file" id="candidate-file" accept="image/*" />
              <small class="help-text">Sélectionnez une image depuis votre téléphone ou PC.</small>
            </div>

            <div class="full-width">
              <p id="candidate-msg" class="info-text" style="display: none;"></p>
              <GoldButton text="Enregistrer le candidat" type="submit" id="submit-btn" />
            </div>
          </form>
        </GlassCard>
      </div>
    )}
  </div>
</Layout>

<script is:inline>
  // Connexion Admin
  document.getElementById('admin-login-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const password = document.getElementById('admin-password').value;
    const errorEl = document.getElementById('login-error');

    const res = await fetch('/api/admin/unlock', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code: password })
    });

    const data = await res.json();
    if (res.ok && data.success) {
      window.location.reload();
    } else {
      errorEl.textContent = data.error || 'Code incorrect.';
      errorEl.style.display = 'block';
    }
  });

  // Déconnexion Admin
  document.getElementById('logout-btn')?.addEventListener('click', async () => {
    await fetch('/api/admin/logout', { method: 'POST' });
    window.location.reload();
  });

  // Soumission du candidat avec upload d'image
  document.getElementById('add-candidate-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msgEl = document.getElementById('candidate-msg');
    const fileInput = document.getElementById('candidate-file');
    const submitBtn = document.getElementById('submit-btn');

    msgEl.style.display = 'none';
    if (submitBtn) submitBtn.disabled = true;

    const formData = new FormData();
    formData.append('name', document.getElementById('candidate-name').value);
    formData.append('category', document.getElementById('candidate-category').value);

    // Si une photo est sélectionnée
    if (fileInput.files && fileInput.files[0]) {
      formData.append('photo', fileInput.files[0]);
    }

    try {
      const res = await fetch('/api/admin/candidates', {
        method: 'POST',
        body: formData // On envoie le FormData directement (multipart/form-data)
      });

      const data = await res.json();

      if (res.ok && data.success) {
        msgEl.textContent = "✅ Candidat ajouté avec succès !";
        msgEl.style.color = "#4ade80";
        msgEl.style.display = "block";
        e.target.reset();
      } else {
        msgEl.textContent = "❌ " + (data.error || "Erreur lors de l'ajout");
        msgEl.style.color = "#ef4444";
        msgEl.style.display = "block";
      }
    } catch (err) {
      msgEl.textContent = "Erreur réseau lors de l'envoi.";
      msgEl.style.color = "#ef4444";
      msgEl.style.display = "block";
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>

<style>
  .admin-container { max-width: 800px; margin: 3rem auto; padding: 0 1rem; }
  .login-box { max-width: 420px; margin: 0 auto; text-align: center; }
  .mask-icon { font-size: 3rem; }
  h1 { color: #fff; font-size: 1.8rem; margin-bottom: 0.5rem; }
  .subtitle { color: #a1a1aa; margin-bottom: 2rem; }

  .admin-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem; }
  .header-btns { display: flex; gap: 1rem; }

  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .full-width { grid-column: span 2; }
  
  .form-group label { display: block; margin-bottom: 0.5rem; color: #d4d4d8; font-size: 0.9rem; }
  .form-group input, .form-group select {
    width: 100%; padding: 0.75rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2);
    background: rgba(0,0,0,0.4); color: #fff; box-sizing: border-box;
  }

  .help-text { color: #a1a1aa; font-size: 0.8rem; margin-top: 0.3rem; display: block; }
  .btn-outline { color: var(--gold, #D4AF37); border: 1px solid var(--gold, #D4AF37); padding: 8px 16px; border-radius: 8px; text-decoration: none; font-size: 0.9rem; }
  .btn-danger { background: #ef4444; color: #fff; border: none; padding: 8px 16px; border-radius: 8px; cursor: pointer; font-weight: 600; }
  .error-text { color: #ef4444; margin-top: 1rem; }
  .info-text { margin-bottom: 1rem; font-weight: 600; text-align: center; }
</style>
