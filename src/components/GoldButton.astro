---
interface Props {
  text: string;
  type?: "button" | "submit" | "reset";
}

const { text, type = "button" } = Astro.props;
---

<button type={type} class="gold-button">
  <span>{text}</span>
</button>

<style>
  .gold-button {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, var(--gold-light, #F1D592) 0%, var(--gold-deep, #A6791F) 100%);
    color: #241705;
    border: none;
    padding: 16px 28px;
    border-radius: 30px;
    font-family: var(--font-body, 'Outfit', sans-serif);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    cursor: pointer;
    width: 100%;
    box-shadow: 0 6px 24px rgba(241, 213, 146, 0.25);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .gold-button::before {
    content: '';
    position: absolute;
    top: 0;
    left: -60%;
    width: 40%;
    height: 100%;
    background: linear-gradient(120deg, transparent, rgba(255, 255, 255, 0.5), transparent);
    transform: skewX(-20deg);
    transition: left 0.6s ease;
  }

  .gold-button:hover::before {
    left: 130%;
  }

  .gold-button:hover {
    box-shadow: 0 8px 30px rgba(241, 213, 146, 0.4);
    transform: translateY(-2px);
  }

  .gold-button:active {
    transform: translateY(1px) scale(0.98);
  }
</style>
