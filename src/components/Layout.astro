---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Vote pour le Bal de Promo" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} - Bal de Promo</title>
  </head>
  <body>
    <div class="background-overlay"></div>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --gold: #d4af37; 
    --gold-hover: #f1c40f; 
    --black-bg: #0a0a0a; 
    --black-accent: #1a1a1a; 
    --white: #ffffff; 
    --text-color: #e0e0e0; 
  }

  html, body {
    margin: 0;
    padding: 0;
    font-family: 'Playfair Display', 'Times New Roman', serif;
    background-color: var(--black-bg);
    color: var(--text-color);
  }

  .background-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, #1a1a1a 0%, #000000 100%);
    z-index: -1;
  }

  main {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
    min-height: 100vh;
  }

  h1, h2, h3 {
    color: var(--gold);
    text-align: center;
    font-weight: bold;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  h1 { font-size: 2.5rem; margin-bottom: 0.5rem; }
  h2 { font-size: 1.8rem; }
  
  input, select {
    background-color: var(--black-accent);
    color: var(--white);
    border: 1px solid rgba(212, 175, 55, 0.4);
    padding: 12px;
    border-radius: 8px;
    width: 100%;
    box-sizing: border-box;
    margin-bottom: 1rem;
    font-family: inherit;
  }

  input:focus, select:focus {
    border-color: var(--gold);
    outline: none;
    box-shadow: 0 0 8px rgba(212, 175, 55, 0.3);
  }
</style>
