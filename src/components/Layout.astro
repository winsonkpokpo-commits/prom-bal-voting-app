---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Vote pour le Bal de Promo" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		
		<!-- Google Fonts: Cinzel (Titres) & Work Sans (Texte) -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Work+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
		
		<title>{title} | Bal Masqué</title>
	</head>
	<body>
		<!-- Élément de décoration d'arrière-plan -->
		<div class="background-glow"></div>
		
		<main>
			<slot />
		</main>

		<footer class="site-footer" role="contentinfo">
			<div class="site-credit">D'après l'idée originale de GNASSOUNOU Trésor, Réalisé par Winson KPOKPO</div>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--color-bg: #0b0a09;
		--color-gold: #d4af37;
		--color-gold-light: #e6c55d;
		--color-text-main: #f4f0ec;
		--color-text-muted: #bdae9d;
		
		--font-title: 'Cinzel', serif;
		--font-body: 'Work Sans', sans-serif;
	}

	*, *::before, *::after {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		padding: 0;
		background-color: var(--color-bg);
		color: var(--color-text-main);
		font-family: var(--font-body);
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		overflow-x: hidden;
		position: relative;
	}

	.background-glow {
		position: fixed;
		top: -20%;
		left: -10%;
		width: 50vw;
		height: 50vw;
		background: radial-gradient(circle, rgba(212, 175, 55, 0.1) 0%, rgba(11, 10, 9, 0) 70%);
		border-radius: 50%;
		z-index: -1;
		pointer-events: none;
	}

	.background-glow::after {
		content: "";
		position: absolute;
		bottom: -100%;
		right: -150%;
		width: 60vw;
		height: 60vw;
		background: radial-gradient(circle, rgba(212, 175, 55, 0.08) 0%, rgba(11, 10, 9, 0) 70%);
		border-radius: 50%;
	}

	main {
		width: 100%;
		max-width: 800px;
		padding: 2rem 1.5rem;
		z-index: 1;
	}

	footer.site-footer {
		width: 100%;
		max-width: 800px;
		padding: 0.75rem 1.5rem;
		margin-top: auto;
		text-align: center;
		color: var(--color-text-muted);
		font-size: 0.85rem;
		opacity: 0.95;
		font-family: var(--font-body);
	}

	.site-credit {
		/* Texte sobre et lisible */
		color: var(--color-text-muted);
		font-size: 0.85rem;
		line-height: 1;
	}

	h1, h2, h3, h4, h5, h6 {
		font-family: var(--font-title);
		font-weight: 600;
		color: var(--color-gold);
		margin-top: 0;
	}

	h1 {
		font-size: 2.5rem;
		text-align: center;
		margin-bottom: 2rem;
		letter-spacing: 0.05em;
		text-shadow: 0 2px 10px rgba(212, 175, 55, 0.2);
	}

	p {
		line-height: 1.6;
		color: var(--color-text-muted);
	}

	/* Formulaires et Boutons globaux */
	button, .btn {
		background: linear-gradient(135deg, rgba(212, 175, 55, 0.8) 0%, rgba(184, 150, 40, 0.8) 100%);
		color: #000;
		border: 1px solid var(--color-gold-light);
		padding: 0.75rem 1.5rem;
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 1rem;
		border-radius: 4px;
		cursor: pointer;
		transition: all 0.3s ease;
		text-transform: uppercase;
		letter-spacing: 1px;
		display: inline-block;
		text-align: center;
		text-decoration: none;
		box-shadow: 0 4px 15px rgba(212, 175, 55, 0.2);
	}

	button:hover, .btn:hover {
		background: linear-gradient(135deg, rgba(230, 197, 93, 0.9) 0%, rgba(212, 175, 55, 0.9) 100%);
		box-shadow: 0 6px 20px rgba(212, 175, 55, 0.4);
		transform: translateY(-2px);
	}
	
	button:disabled {
		background: #333;
		border-color: #555;
		color: #888;
		cursor: not-allowed;
		box-shadow: none;
		transform: none;
	}

	input, select {
		width: 100%;
		padding: 0.75rem 1rem;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(212, 175, 55, 0.3);
		border-radius: 4px;
		color: var(--color-text-main);
		font-family: var(--font-body);
		font-size: 1rem;
		transition: border-color 0.3s, box-shadow 0.3s;
		margin-bottom: 1rem;
	}

	input:focus, select:focus {
		outline: none;
		border-color: var(--color-gold);
		box-shadow: 0 0 0 2px rgba(212, 175, 55, 0.2);
		background: rgba(255, 255, 255, 0.1);
	}
	
	/* Style personnalisé pour les options de select */
	select option {
		background-color: var(--color-bg);
		color: var(--color-text-main);
	}

	.error-msg {
		color: #ff6b6b;
		background: rgba(255, 107, 107, 0.1);
		border-left: 4px solid #ff6b6b;
		padding: 1rem;
		margin-bottom: 1.5rem;
		border-radius: 0 4px 4px 0;
	}

	.success-msg {
		color: #51cf66;
		background: rgba(81, 207, 102, 0.1);
		border-left: 4px solid #51cf66;
		padding: 1rem;
		margin-bottom: 1.5rem;
		border-radius: 0 4px 4px 0;
	}
	
	.loader {
		display: inline-block;
		width: 20px;
		height: 20px;
		border: 3px solid rgba(0,0,0,0.3);
		border-radius: 50%;
		border-top-color: #000;
		animation: spin 1s ease-in-out infinite;
	}
	
	@keyframes spin {
		to { transform: rotate(360deg); }
		}
</style>
