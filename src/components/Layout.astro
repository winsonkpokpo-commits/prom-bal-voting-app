---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} - Bal de Promo</title>
  </head>
  <body>
    <div class="background-overlay"></div>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    /* Direction "Bal Masqué" */
    --ink: #0C0810;
    --velvet: #3B1024;
    --gold-light: #F1D592;
    --gold-deep: #A6791F;
    --ivory: #F3EAE0;
    --smoke: #A89A8C;

    --font-display: 'Cinzel', serif;
    --font-body: 'Outfit', sans-serif;

    /* Alias conservés pour compatibilité avec les pages pas encore mises à jour (admin, login, résultats) */
    --gold: #D4AF37;
    --gold-glow: rgba(241, 213, 146, 0.35);
    --bg-dark: var(--ink);
    --glass-bg: rgba(20, 20, 25, 0.6);
  }

  html, body {
    margin: 0;
    padding: 0;
    font-family: var(--font-body);
    background-color: var(--ink);
    color: var(--ivory);
  }

  .background-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(ellipse 900px 500px at 50% -10%, var(--velvet) 0%, transparent 60%),
      var(--ink);
    z-index: -1;
  }

  main {
    max-width: 600px;
    margin: 0 auto;
    padding: 1.5rem;
    min-height: 100vh;
  }

  /* Typographie */
  h1, h2, h3 {
    font-family: var(--font-display);
    color: var(--gold-light);
    text-align: center;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-shadow: 0 0 20px rgba(241, 213, 146, 0.2);
  }

  h1 { font-size: 2rem; margin-bottom: 0.5rem; letter-spacing: 2.5px; }
  h2 { font-size: 1.3rem; letter-spacing: 1.5px; }

  /* Champs de saisie */
  input, select, textarea {
    background: rgba(255, 255, 255, 0.04);
    color: var(--ivory);
    border: 1px solid rgba(241, 213, 146, 0.18);
    padding: 14px 18px;
    border-radius: 10px;
    width: 100%;
    box-sizing: border-box;
    margin-bottom: 1rem;
    font-family: var(--font-body);
    font-size: 1rem;
    transition: all 0.25s ease;
  }

  input:focus, select:focus, textarea:focus {
    border-color: var(--gold-light);
    outline: none;
    background: rgba(255, 255, 255, 0.07);
    box-shadow: 0 0 0 3px rgba(241, 213, 146, 0.12);
  }

  /* Bouton par défaut — discret. Les CTA marquants utilisent GoldButton / .gold-action-btn */
  button {
    background: rgba(241, 213, 146, 0.08);
    color: var(--ivory);
    border: 1px solid rgba(241, 213, 146, 0.28);
    padding: 14px 24px;
    border-radius: 10px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.2s ease;
    width: 100%;
    margin-top: 10px;
  }

  button:hover {
    background: rgba(241, 213, 146, 0.15);
    border-color: var(--gold-light);
  }

  button:active {
    transform: scale(0.97);
  }

  .vote-blanc {
    background: rgba(255, 255, 255, 0.04) !important;
    color: var(--smoke) !important;
    border: 1px dashed rgba(255, 255, 255, 0.15) !important;
  }
</style>
